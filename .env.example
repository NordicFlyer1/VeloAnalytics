# Copy to .env.local and add your own keys. Never commit a file containing real keys.
#
# IMPORTANT: VITE_* values are built into the app and can be seen by anyone who can
# access that build. Use them only for your own local/private app. Do not use them
# in a public or shared deployment. For that, keep provider keys on a server.

# AI provider keys (optional)
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GROQ_API_KEY=

# Google Maps key (browser-visible; restrict it to the required APIs and your app)
VITE_GOOGLE_MAPS_API_KEY=

# OpenWeatherMap key (browser-visible)
VITE_OPENWEATHERMAP_API_KEY=

# Optional Vercel Basic Auth credentials
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
