{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VeloAnalytics",
  "version": "0.2.0",
  "identifier": "com.bruce.veloanalytics",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VeloAnalytics",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "dialog": null,
    "fs": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Privacy-first cycling analytics & telemetry platform",
    "longDescription": "High-resolution cycling analytics platform featuring power curve modeling, W' balance analysis, HRV dynamics, and workout performance metrics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "entitlements": null,
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null
    }
  }
}
